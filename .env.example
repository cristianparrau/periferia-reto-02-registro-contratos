# Proveedor de lenguaje (solo backend; nunca se expone al front ni a los logs)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Límites de costo
MAX_ITERACIONES=25
MAX_TOKENS_SESION=200000
LLM_TIMEOUT_MS=60000
# Protección del link público: mensajes de chat por IP por minuto y sesiones en memoria
LIMITE_CHAT_POR_MINUTO=10
MAX_SESIONES=200
# Servidor
PORT=3000
# true cuando corre detrás de un proxy (Render): usa X-Forwarded-For para identificar la IP
CONFIAR_PROXY=false
# Opcional: fija la fecha de referencia para vigencias (YYYY-MM-DD). Por defecto, hoy.
FECHA_REFERENCIA=
