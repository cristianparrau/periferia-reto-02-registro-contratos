{
  "name": "reto-02-registro-contratos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Agente conversacional para el registro de contratos vigentes desde un buzón único",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/server.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "demo": "tsx demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "verificar": "tsx scripts/verificar-entorno.ts",
    "verificar:conexion": "tsx scripts/verificar-entorno.ts --conectar"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
